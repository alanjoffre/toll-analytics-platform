# Copie para .env e ajuste. NÃO comite segredos.

# Ambiente alvo do dbt: dev (default) ou prod
DBT_TARGET=dev

# Schedules (cron). Vazio = usa o default do DAG.
TOLL_PIPELINE_SCHEDULE=0 6 * * *
TOLL_OBSERVABILITY_SCHEDULE=0 7 * * *

# Confiabilidade
AIRFLOW_TASK_RETRIES=2
AIRFLOW_RETRY_DELAY_MIN=2

# Alertas (opcional). Se vazio, a falha é apenas logada.
SLACK_WEBHOOK_URL=

# --- Apenas para execução LOCAL (sem Docker) -------------------------------
# Sobrescreva se o projeto dbt ou o venv não estiverem nos caminhos padrão.
# DBT_PROJECT_DIR=/caminho/para/dbt-toll-analytics
# DBT_EXECUTABLE_PATH=/caminho/para/dbt-toll-analytics/.venv/bin/dbt
# DBT_PROFILES_DIR=/caminho/para/dbt-toll-analytics
